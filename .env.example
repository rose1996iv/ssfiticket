# ==============================================================================
# SSFI Lucky Draw Management System — Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or expose production secrets in source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Platform (Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Public Supabase URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public publishable key (anon key). Safe for browser use under Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Service Role Key: Bypasses Row Level Security.
# Required for atomic server actions, administrative RPCs, and cron jobs.
# NEVER expose to client/browser. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. Application URLs & Canonical Domain
# ------------------------------------------------------------------------------
# Base Application URL (set to http://localhost:3000 for local development)
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Public Payment & Organization Fallback Settings
# ------------------------------------------------------------------------------
# Central organization fallback UPI details (when seller personal QR is unavailable)
NEXT_PUBLIC_SSFI_UPI_ID=6909251270@ptaxis
NEXT_PUBLIC_SSFI_UPI_DISPLAY_NAME=HLAWN THA DAWT
NEXT_PUBLIC_SSFI_UPI_QR_PATH=/upi_qr.jpeg

# Mock payment mode toggle ("true" for simulated tests, "false" in Production)
NEXT_PUBLIC_MOCK_PAYMENTS=false

# Support Contacts
NEXT_PUBLIC_SUPPORT_EMAIL=Senthangstudents@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=

# Hero background YouTube video URL or ID (optional decorative background)
NEXT_PUBLIC_HERO_YOUTUBE_URL=https://www.youtube.com/watch?v=7QPnU6argBg

# ------------------------------------------------------------------------------
# 4. Cron & Automated Schedule Webhooks
# ------------------------------------------------------------------------------
# Secret token for authenticating scheduled cron invocations (e.g. /api/cron/campaign-schedule)
CRON_SECRET=

# ------------------------------------------------------------------------------
# 5. Email Delivery (Resend API & Gmail Outbox)
# ------------------------------------------------------------------------------
# Resend API Key for automated customer ticket delivery emails
RESEND_API_KEY=
EMAIL_FROM=SSFI Lucky Draw <tickets@ssfiticket.org>

# Development & Preview email safety gates
RESEND_DRY_RUN=true
ALLOWED_TEST_EMAIL=

# Optional Gmail API configuration
GMAIL_CUSTOMER_LIVE_SEND_ENABLED=false
GMAIL_PREVIEW_REAL_SEND_ENABLED=false
GMAIL_PREVIEW_ALLOWED_RECIPIENT=
GMAIL_ADMIN_TEST_RECIPIENT=

# ------------------------------------------------------------------------------
# 6. WhatsApp Cloud API (Optional Direct Messaging)
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALLOWED_TEST_PHONE=
