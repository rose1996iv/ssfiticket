# Public: URL used by browser and server Supabase clients.
NEXT_PUBLIC_SUPABASE_URL=
# Public: Supabase publishable key. Protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: privileged key that bypasses RLS. NEVER expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public / Server-side application URLs
# Canonical production URL (https://ssfiticket.vercel.app)
APP_BASE_URL=https://ssfiticket.vercel.app
NEXT_PUBLIC_APP_URL=https://ssfiticket.vercel.app

# Public payment instructions; these are shown to buyers and sellers and contain no secrets.
NEXT_PUBLIC_SSFI_UPI_ID=
NEXT_PUBLIC_SSFI_UPI_DISPLAY_NAME=SSFI Fundraising

# Optional: Official Support Contact info
NEXT_PUBLIC_SUPPORT_EMAIL=Senthangstudents@gmail.com
# NEXT_PUBLIC_SUPPORT_PHONE=+91...

# Server-only: Resend Email Provider Configuration
RESEND_API_KEY=
# Sender email address (must be from a verified domain on Resend, e.g. "SSFI Lucky Draw <tickets@ssfiticket.org>")
EMAIL_FROM=SSFI Lucky Draw <onboarding@resend.dev>

# Development / Preview safety guards:
# In Preview / Dev, emails are simulated by default unless recipient matches ALLOWED_TEST_EMAIL.
# ALLOWED_TEST_EMAIL=developer@example.com
# RESEND_DRY_RUN=true

# Optional: YouTube video or live stream URL for decorative hero background (e.g. https://www.youtube.com/watch?v=VIDEO_ID)
NEXT_PUBLIC_HERO_YOUTUBE_URL=https://www.youtube.com/watch?v=7QPnU6argBg
